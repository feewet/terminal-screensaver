#!/bin/zsh
# Plays a random ASCII scene from $APP/screensavers until any key is pressed.
# Art and player: github.com/kailashsr38/ascii-magic-art (MIT), cloned to $APP.
APP=$HOME/.local/share/ascii-magic-art
# The player runs its pieces as code, so only the reviewed commit plays. A pull or a failed
# checkout leaves HEAD elsewhere and the tab opens straight to the prompt.
PIN=de88962156057cbef583bd265bf55e23d6c5e30d
# Absolute paths, not $PATH: a node planted earlier in $PATH would run on every new tab.
# Using nvm, volta or similar? Put your node's absolute path first.
for NODE in /opt/homebrew/bin/node /usr/local/bin/node; do [[ -x $NODE ]] && break; done
[[ -x $NODE && -f $APP/bin/cli.js && -r $APP/.git/HEAD && $(<$APP/.git/HEAD) == $PIN ]] || exit 0
# The player only knows pieces in its pinned pieces/ dir; skip any it can't play.
picks=()
for s in $APP/screensavers/*.js(N:t:r); do [[ -f $APP/pieces/$s.js ]] && picks+=$s; done
(( $#picks )) || exit 0
# --seconds is upstream's shell-startup mode: no exit hint, and a cap for forgotten tabs.
$NODE $APP/bin/cli.js ${picks[RANDOM % ${#picks} + 1]} --seconds=86400 "$@"
# The player eats only the key that stopped it. Drop anything typed after, so the tail of a
# half-eaten command or paste never reaches the prompt and runs.
[[ -t 0 ]] && while read -t 0 -k 1 -s; do :; done
